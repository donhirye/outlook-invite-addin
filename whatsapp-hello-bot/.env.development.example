# Copy to .env.development (gitignored) and fill in values.
# Used ONLY by scripts/run-dev.ps1 — never loaded for production/staging Cloud Run.

APP_ENV=development

# Local admin login (defaults ok for laptop-only DEV)
ADMIN_PASSWORD=dev-local-password
SECRET_KEY=dev-local-secret-key-at-least-32-chars!!

# Leave WhatsApp empty (sends are hard-blocked in DEV anyway)
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# REQUIRED: use a separate DEV OpenAI project/key (not production or staging)
OPENAI_API_KEY=
# Match production baseline for first comparisons; change later for experiments
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=none

# Fake Test Chat FAQ-admin persona
FAQ_ADMIN_PHONES=15550100003

# MUST stay empty — DEV refuses to start if a GCS bucket is set
FAQ_GCS_BUCKET=
FAQ_GCS_OBJECT=science_olympiad_faq.txt
FAQ_GCS_INDEX_OBJECT=science_olympiad_faq.txt.index.json

# Production-matching retrieval baseline (change explicitly for experiments)
FAQ_EMBEDDING_MODEL=text-embedding-3-small
FAQ_TOP_K=4
FAQ_SKIP_RAG_MAX_CHARS=30000

GUIDED_ENABLED=true

# Releases dashboard — read-only live /health probes (no tokens)
STAGING_BASE_URL=https://whatsapp-faq-bot-staging-lvay5sgo6q-uc.a.run.app
PRODUCTION_BASE_URL=
# Optional: stamp local DEV health responses via process env GIT_SHA (do not leave an empty GIT_SHA= line here — it would wipe the process env)
