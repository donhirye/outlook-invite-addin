# Copy this file to .env and fill in values.

# Password for the admin webpage that edits the greeting
ADMIN_PASSWORD=changeme

# Used to sign admin session cookies — change this in production
SECRET_KEY=change-me-to-a-long-random-string

# WhatsApp Cloud API (from Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=my-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: Graph API version
GRAPH_API_VERSION=v21.0

# OpenAI (event FAQ assistant)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
# gpt-5* Responses API: none|minimal|low|medium|high (empty = omit)
OPENAI_REASONING_EFFORT=minimal
# Live answer path is Ep. Pinned regression prompts: evals/eval_set.md

# Durable FAQ on Cloud Run (recommended). Leave empty for local file storage.
# Create a bucket, grant the Cloud Run service account objectAdmin, then set:
FAQ_GCS_BUCKET=
FAQ_GCS_OBJECT=science_olympiad_faq.txt
FAQ_GCS_INDEX_OBJECT=science_olympiad_faq.txt.index.json

# Combined newsletter FAQ + structured index (eng-rag). Staging hierarchy:
#   gs://<bucket>/newsletter_archive/combined_FAQ_latest.csv
#   gs://<bucket>/newsletter_archive/combined_FAQ_latest.csv.index.json
# NEWSLETTER_COMBINED_FAQ_LOCAL=data/newsletter_archive/combined_FAQ_latest.csv
# NEWSLETTER_COMBINED_FAQ_GCS_OBJECT=newsletter_archive/combined_FAQ_latest.csv
# NEWSLETTER_COMBINED_FAQ_INDEX_GCS_OBJECT=newsletter_archive/combined_FAQ_latest.csv.index.json
# Set true on staging after uploading the index (scripts/build_newsletter_faq_index.py).
# That script is the standard publish step: CSV → faq_records.json + RAG index.
USE_NEWSLETTER_COMBINED_FAQ_INDEX=false

# RAG: embed FAQ chunks and retrieve top-k instead of sending the whole file
FAQ_EMBEDDING_MODEL=text-embedding-3-small
FAQ_TOP_K=4
# Skip embeddings when FAQ is this size or smaller (0 = always use RAG).
# When 0 on the live path, RAG uses structured combined_FAQ chunks/index
# (newsletter_archive/...), not flat-text Q:/A: reparse.
FAQ_SKIP_RAG_MAX_CHARS=30000

# --- Newsletter archive (offline tooling; not used by live WhatsApp path) ---
# Drive parent folder ID only (not the full URL). Example Crone archive parent:
# NEWSLETTER_DRIVE_PARENT_FOLDER_ID=1a7Lq5kjfckxn73RztFDpw0eSgOwwW53N
NEWSLETTER_DRIVE_PARENT_FOLDER_ID=
# Optional OAuth paths (defaults: whatsapp-hello-bot/.secrets/...)
# GOOGLE_OAUTH_CLIENT_SECRETS=
# GOOGLE_OAUTH_TOKEN_PATH=
# Optional default Gmail query when --query/--label omitted:
# NEWSLETTER_DEFAULT_GMAIL_QUERY=
