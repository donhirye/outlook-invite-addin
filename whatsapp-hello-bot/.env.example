# Copy this file to .env and fill in values.

# Password for the admin webpage that edits the greeting
ADMIN_PASSWORD=changeme

# Used to sign admin session cookies — change this in production
SECRET_KEY=change-me-to-a-long-random-string

# WhatsApp Cloud API (from Meta Developer Console)
WHATSAPP_VERIFY_TOKEN=my-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: Graph API version
GRAPH_API_VERSION=v21.0

# OpenAI (event FAQ assistant)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-5.6-luna

# Comma-separated admin phones allowed to run /faq (country code, no +)
# Example: 18122165774,15551234567
FAQ_ADMIN_PHONES=

# Durable FAQ on Cloud Run (recommended). Leave empty for local file storage.
# Create a bucket, grant the Cloud Run service account objectAdmin, then set:
FAQ_GCS_BUCKET=
FAQ_GCS_OBJECT=science_olympiad_faq.txt
FAQ_GCS_INDEX_OBJECT=science_olympiad_faq.txt.index.json

# RAG: embed FAQ chunks and retrieve top-k instead of sending the whole file
FAQ_EMBEDDING_MODEL=text-embedding-3-small
FAQ_TOP_K=4
