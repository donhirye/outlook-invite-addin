# Cloud Run source-upload exclusions.
# .dockerignore only affects the Docker build after upload; this file
# controls what gcloud packs into the GCS source archive.

.gcloudignore
.git
.gitignore

# Secrets and local env
.env
.env.*
!.env.example

# Local Python environments and caches
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local learning / analysis materials (never ship to Cloud Run)
playground/
data analysis/
learnings.txt
*.csv

# Runtime / local-only data
data/usage_metrics.json
data/guided_state.json
data/guided_metrics.json
data/webhook_seen.json
data/*.index.json
data/faq_backup.txt

# Docs and local tooling not needed to build the image
*.md
scripts/
tests/
